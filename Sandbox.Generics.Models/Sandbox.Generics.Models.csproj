<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>nullable</WarningsAsErrors>
		<EnableNETAnalyzers>True</EnableNETAnalyzers>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DataFac.Memory" Version="2.0.15" />
		<PackageReference Include="DTOMaker.Models" Version="3.0.45-dev" />
		<PackageReference Include="DTOMaker.Models.BinaryTree" Version="3.0.45-dev" />
		<PackageReference Include="DTOMaker.Runtime.JsonSystemText" Version="3.0.45-dev" />
		<PackageReference Include="DTOMaker.Runtime.MemBlocks" Version="3.0.45-dev" />
		<PackageReference Include="DTOMaker.SrcGen.JsonSystemText" Version="3.0.45-dev" />
		<PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
		<PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="System.Text.Json" Version="10.0.11" />
	</ItemGroup>

</Project>
